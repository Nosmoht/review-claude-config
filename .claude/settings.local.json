{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(**/.env)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.kube/**)",
      "Edit(**/.env)",
      "Edit(**/.npmrc)",
      "Edit(**/.pypirc)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebSearch",
      "WebFetch(domain:martinfowler.com)",
      "WebFetch(domain:arxiv.org)",
      "Bash(grep:*)",
      "Bash(git mv:*)",
      "Bash(ls reports/review-claude-config/*.md)",
      "Bash(git rm:*)",
      "Bash(python scripts/validate_token_budgets.py)",
      "Bash(python -m pytest tests/test_policy_gate.py -v)",
      "Bash(make validate:*)"
    ]
  }
}
