{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": false,
  "bump-patch-for-minor-pre-major": false,
  "pull-request-title-pattern": "chore(release): release ${version}",
  "pull-request-header": "Automated release PR by release-please. Maintainer adds Keep-a-Changelog migration prose to the CHANGELOG section before merging.",
  "changelog-sections": [
    { "type": "feat", "section": "Changed" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Changed" },
    { "type": "refactor", "section": "Changed" },
    { "type": "docs", "section": "Changed", "hidden": true },
    { "type": "chore", "hidden": true },
    { "type": "ci", "hidden": true },
    { "type": "test", "hidden": true },
    { "type": "style", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "claude-config",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
