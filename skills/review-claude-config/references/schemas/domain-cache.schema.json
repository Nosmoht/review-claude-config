{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-claude-config:domain-cache",
  "title": "domain-cache",
  "description": "Frontmatter contract for skills/review-claude-config/references/domain-cache/*.md",
  "type": "object",
  "required": ["domain", "last_refreshed"],
  "additionalProperties": true,
  "properties": {
    "domain": {"type": "string", "minLength": 1},
    "last_refreshed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
