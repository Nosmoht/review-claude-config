{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-claude-config:hooks-json",
  "title": "hooks-json",
  "description": "Structure contract for hooks/hooks.json",
  "type": "object",
  "required": ["hooks"],
  "additionalProperties": true,
  "properties": {
    "hooks": {
      "type": "object",
      "patternProperties": {
        "^[A-Z][a-zA-Z]+$": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hooks"],
            "properties": {
              "hooks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["command"],
                  "properties": {
                    "command": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
