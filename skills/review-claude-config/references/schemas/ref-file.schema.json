{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-claude-config:ref-file",
  "title": "ref-file",
  "description": "Frontmatter contract for skills/*/references/*.md",
  "type": "object",
  "required": ["name", "description", "last_refreshed"],
  "additionalProperties": true,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "last_refreshed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
