{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-claude-config:research",
  "title": "research",
  "description": "Frontmatter contract for research/**/*.md",
  "type": "object",
  "required": ["last_refreshed"],
  "additionalProperties": true,
  "properties": {
    "last_refreshed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
